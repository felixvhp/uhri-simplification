data/*
!data/*.zip
!data/*.tar
!data/*.tar.gz
!data/*.sh


.DS_store

# Secrets — never commit these
.env
*.env


# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
venv311/

# Caches
.pytest_cache/
.mypy_cache/

# reviewer submissions collected by src/feedback_form/serve.py (data, not source)
src/feedback_form/exports/

# personal metrics/prompts/settings saved by the tools (defaults/ is the tracked copy)
src/settings/user/*
!src/settings/user/.gitkeep

# Packaging
build/
*.egg-info/
